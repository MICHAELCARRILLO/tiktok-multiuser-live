# Copia este archivo a .env y pon tus valores.

# Dominio público (con https) donde servirás la app, detrás de tu proxy con TLS.
URL_PUBLICA=https://live.tudominio.com

# IP pública de tu servidor (la que se ve desde internet).
IP_PUBLICA=1.2.3.4

# Rango de puertos UDP para el video. Ábrelos en el firewall del servidor.
ICE_PUERTO_MIN=40000
ICE_PUERTO_MAX=40030

# Puerto HTTP interno que usa tu proxy (no se expone a internet).
PUERTO_APP=8099
